# Caddy holt und erneuert das HTTPS-Zertifikat automatisch (Let's Encrypt).
# DOMAIN kommt aus der .env-Datei, z. B. DOMAIN=grow.deine-domain.de
{$DOMAIN} {
	encode zstd gzip

	# Sicherheits-Header setzt die App selbst; Server-Kennung entfernen
	header -Server

	# Anfragen größer als nötig früh abweisen (Fotos max. ca. 0,7 MB, Zustand max. 3 MB)
	request_body {
		max_size 4MB
	}

	reverse_proxy app:8080 {
		# Caddy übernimmt keine vom Client gefälschten X-Forwarded-For-Werte und hängt die echte IP an
		header_up X-Forwarded-Proto {scheme}
	}

	# Kein Zugriffsprotokoll mit IP-Adressen (die App protokolliert ohne IP).
	# Falls gewünscht: log { output file /data/access.log { roll_keep_for 168h } } und Datenschutzerklärung anpassen.
}

# www auf die Hauptdomain umleiten (optional)
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
