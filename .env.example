# Kopieren nach .env und anpassen. Datei niemals einchecken!
DOMAIN=grow.deine-domain.de

# Pflicht: mind. 32 zufällige Zeichen, z. B. erzeugen mit: openssl rand -hex 32
# NIE nachträglich ändern – sonst passen die Logins nicht mehr. Getrennt vom Server sicher aufbewahren!
AUTOPOT_SECRET=

# open | invite | closed   (für den Start empfohlen: invite)
REGISTRATION=invite
# Bot-Schutz bei offener Registrierung (Rechenaufgabe im Browser), 0 = aus
POW_BITS=16
# Höchstzahl Konten (0 = unbegrenzt) und neue Konten pro 24 h
MAX_USERS=0
REG_DAILY_MAX=50
# Speicher pro Konto in MB
USER_QUOTA_MB=200

# Hinter Proxy/HTTPS-Terminierung (Caddy, Render, Fly …) = 1
TRUST_PROXY=1
# Nur hinter Cloudflare UND wenn der Server ausschließlich Cloudflare-IPs annimmt:
# CLIENT_IP_HEADER=cf-connecting-ip

SESSION_DAYS=30
SESSION_MAX_DAYS=90
API_RATE_PER_MIN=300
KDF_CONCURRENCY=4

# Metriken für Prometheus/Grafana unter /api/metrics (Header: Authorization: Bearer <Token>); leer = aus
METRICS_TOKEN=
# Zugriffsprotokoll (ohne IP) auf stdout: on | off
LOG=on
