# Kopieren nach .env bzw. als Umgebungsvariablen beim Hoster setzen
PORT=8080
HOST=0.0.0.0
DATA_DIR=./server-data
# open | closed
REGISTRATION=open
# 1, wenn ein Reverse-Proxy (Render, Fly, Caddy, nginx) HTTPS terminiert
TRUST_PROXY=0
SESSION_DAYS=30
# mind. 32 Zeichen; sonst wird server-data/server-secret.key erzeugt. Nie nachträglich ändern!
AUTOPOT_SECRET=
