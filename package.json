{
  "name": "autopot-grow",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "AutoPot Grow: Website mit Konten, verschlüsselter Cloud-Synchronisation, Grow-App und Anleitung. Server ohne Fremdpakete (Node >= 22.5).",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "test": "node --test tests/server.test.js && node tests/smoke.test.js && node tests/e2e.test.js",
    "test:server": "node --test tests/server.test.js",
    "test:browser": "node tests/smoke.test.js && node tests/e2e.test.js",
    "serve:static": "python3 -m http.server 8080",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.js",
    "admin": "node --disable-warning=ExperimentalWarning server/admin.js",
    "restore-test": "node --disable-warning=ExperimentalWarning server/restore.js --test",
    "test:load": "node --disable-warning=ExperimentalWarning tests/load.js"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
